# 허용목록 방식 — 기본은 전부 제외, 아래에 적은 것만 올린다 (공개 저장소: 원고·원본 이미지·키는 절대 올리지 않는다)
/*

!/.gitignore
!/CNAME
!/*.html
!/*.txt
!/*.xml
!/search.json
!/favicon.svg
!/favicon.png
!/og.png
!/assets/
!/img/
!/money/
!/season/
!/game/
!/daily/
!/tools/
!/.claude/

# 이중 안전장치
.omc/
node_modules/
.claude/settings.local.json
*.md
!tools/**/*.md
!.claude/**/*.md
tools/*.log
